# VPS: use production. Local development: use development.
NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=3001
API_PUBLIC_ORIGIN=https://api.example.com
FRONTEND_ORIGINS=https://your-app.vercel.app
TRUST_PROXY=true
# Always false in production. Never enable a local-owner shortcut on the VPS.
LOCAL_OWNER_ENABLED=false
MONGODB_URI=mongodb+srv://DATABASE_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net
MONGODB_DB=skool_automation
# Preserve the original key when migrating existing encrypted accounts.
COOKIE_ENCRYPTION_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional local-network frontend hosting; leave disabled on the VPS.
LAN_HOST=
LAN_PORT=5174
LAN_CIDR=
LAN_TLS_CERT=.local/lan-cert.pem
LAN_TLS_KEY=.local/lan-key.pem
LAN_STATIC_DIR=public
